{
  "version": 2,
  "name": "browser-video-call-client",
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/socket.io/(.*)",
      "dest": "https://your-server-url.com/socket.io/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
