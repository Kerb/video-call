# Server Configuration
# Railway автоматически устанавливает PORT, не меняйте это значение
PORT=3001

# Node environment
NODE_ENV=production

# STUN Servers (по умолчанию Google public)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Servers (опционально, для production)
# Раскомментируйте и заполните для лучшего прохождения NAT
# TURN_SERVERS=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_PASSWORD=your-password
