# Конфигурация signaling-сервера.
# Файл .env автоматически НЕ загружается (dotenv не используется):
# переменные берутся из окружения — локально из shell, на Railway из Variables.

# Порт сервера (на Railway не задавать — платформа передаёт PORT сама)
PORT=3001

# production — сервер дополнительно раздаёт статику клиента из ../client
NODE_ENV=development

# STUN/TURN: эти переменные сервером не читаются.
# ICE-серверы заданы в client/webrtc.js; TURN — в Roadmap.
